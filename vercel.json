{
  "rewrites": [
    {
      "source": "/api/index",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/license/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    }
  ]
}
