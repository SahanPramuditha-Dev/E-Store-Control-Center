{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/license/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|admin|license|docs|openapi.json).*)",
      "destination": "/index.html"
    }
  ]
}
