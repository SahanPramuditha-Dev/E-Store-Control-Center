# =============================================================================
# E-STORE SAAS CONTROL CENTER & LICENSING PLATFORM - PRODUCTION CONFIGURATION
# =============================================================================

# Server Environment & Security
ENV=production
DEBUG=false
APP_NAME=E-Store Control Center
PORT=8001
HOST=0.0.0.0

# Master Database (PostgreSQL recommended for production multi-tenant licensing)
DATABASE_URL=postgresql://estore_admin:SECURE_STRONG_PASSWORD_HERE@localhost:5432/estore_control_center

# JWT & Admin Session Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_KEY_FOR_JWT_SESSIONS_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cryptographic Ed25519 Root Keyring
# (Generate with: python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; import base64; k=ed25519.Ed25519PrivateKey.generate(); print('PRIV:', base64.b64encode(k.private_bytes_raw()).decode()); print('PUB:', base64.b64encode(k.public_key().public_bytes_raw()).decode())")
LICENSE_PRIVATE_KEY_B64=PASTE_BASE64_ED25519_PRIVATE_KEY_HERE
LICENSE_PUBLIC_KEY_B64=PASTE_BASE64_ED25519_PUBLIC_KEY_HERE
KEY_ID=estore-root-2026-v1

# Security & CORS Settings (Explicit domains only)
CORS_ORIGINS=["https://admin.your-domain.com", "https://control.your-domain.com"]
ALLOWED_HOSTS=["admin.your-domain.com", "control.your-domain.com"]

# Rate Limiting (slowapi / Redis)
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379/0
